          "query_id": 100
        },
        {
          "distance": 0.3,
          "neighbor_id": 2,
          "query_id": 100
        },
        {
          "distance": 0.3,
          "neighbor_id": 3,
          "query_id": 100
        },
        {
          "distance": 0.20000000000000018,
          "neighbor_id": 4,
          "query_id": 101
        }
      ]
    },
    {
      "feature": "knn_rows",
      "input": "query points plus search points",
      "output": "ranked nearest-neighbor rows",
      "rows": [
        {
          "distance": 0.0,
          "neighbor_id": 1,
          "neighbor_rank": 1,
          "query_id": 100
        },
        {
          "distance": 0.3,
          "neighbor_id": 2,
          "neighbor_rank": 2,
          "query_id": 100
        },
        {
          "distance": 0.3,
          "neighbor_id": 3,
          "neighbor_rank": 3,
          "query_id": 100
        },
        {
          "distance": 0.20000000000000018,
          "neighbor_id": 4,
          "neighbor_rank": 1,
          "query_id": 101
        },
        {
          "distance": 1.0,
          "neighbor_id": 5,
          "neighbor_rank": 2,
          "query_id": 101
        },
        {
          "distance": 2.7,
          "neighbor_id": 2,
          "neighbor_rank": 3,
          "query_id": 101
        }
      ]
    },
    {
      "feature": "hausdorff_distance_app",
      "input": "two point sets",
      "output": "directed nearest-neighbor rows reduced to one Hausdorff distance",
      "rows": {
        "hausdorff_distance": 0.30000000000000004,
        "witness_direction": "b_to_a"
      }
    },
    {
      "feature": "ann_candidate_app",
      "input": "query points plus Python-selected candidate points",
      "output": "approximate nearest-neighbor rows plus recall/distance quality",
      "rows": {
        "mean_distance_ratio": 3.666666666666593,
        "recall_at_1": 0.6666666666666666
      }
    },
    {
      "feature": "outlier_detection_app",
      "input": "one point cloud",
      "output": "fixed-radius neighbor rows reduced to density-threshold outlier labels",
      "rows": {
        "matches_oracle": true,
        "outlier_point_ids": [
          7,
          8
        ]
      }
    },
    {
      "feature": "dbscan_clustering_app",
      "input": "one point cloud",
      "output": "fixed-radius neighbor rows reduced to core counts and expanded into density-cluster labels",
      "rows": {
        "cluster_sizes": {
          "1": 4,
          "2": 3
        },
        "matches_oracle": true,
        "noise_point_ids": [
          8
        ]
      }
    },
    {
      "feature": "bfs",
      "input": "frontier vertices plus graph CSR plus visited set",
      "output": "newly discovered vertex rows",
      "rows": [
        {
          "dst_vertex": 2,
          "level": 1,
          "src_vertex": 0
        },
        {
          "dst_vertex": 3,
          "level": 1,
          "src_vertex": 1
        }
      ]
    },
    {
      "feature": "triangle_count",
      "input": "seed edges plus graph CSR",
      "output": "triangle rows",
      "rows": [
        {
          "u": 0,
          "v": 1,
          "w": 2
        }
      ]
    },
    {
      "feature": "conjunctive_scan",
      "input": "denormalized rows plus predicates",
      "output": "matching row IDs",
      "rows": [
        {
          "row_id": 3
        },
        {
          "row_id": 4
        }
      ]
    },
    {
      "feature": "grouped_count",
      "input": "denormalized rows plus predicates plus group key",
      "output": "grouped count rows",
      "rows": [
        {
          "count": 1,
          "region": "east"
        },
        {
          "count": 2,
          "region": "west"
        }
      ]
    },
    {
      "feature": "grouped_sum",
      "input": "denormalized rows plus predicates plus group key and value field",
      "output": "grouped sum rows",
      "rows": [
        {
          "region": "east",
          "sum": 6
        },
        {
          "region": "west",
          "sum": 20
        }
      ]
