{
  "app": "feature_quickstart_cookbook",
  "backend": "cpu_python_reference",
  "feature_count": 25,
  "honesty_boundary": "This cookbook uses the portable CPU Python reference path so every feature shape is easy to learn. Use feature docs and support matrices before making backend/performance claims.",
  "recipes": [
    {
      "feature": "lsi",
      "input": "two segment sets",
      "output": "segment/segment intersection rows",
      "rows": [
        {
          "intersection_point_x": 1.0,
          "intersection_point_y": 1.0,
          "left_id": 1,
          "right_id": 2
        }
      ]
    },
    {
      "feature": "pip",
      "input": "points plus polygons",
      "output": "containment rows",
      "rows": [
        {
          "contains": 1,
          "point_id": 10,
          "polygon_id": 20
        }
      ]
    },
    {
      "feature": "overlay",
      "input": "left polygons plus right polygons",
      "output": "overlap seed rows for exact follow-up",
      "rows": [
        {
          "left_polygon_id": 1,
          "requires_lsi": 1,
          "requires_pip": 0,
          "right_polygon_id": 2
        }
      ]
    },
    {
      "feature": "ray_tri_hitcount",
      "input": "rays plus triangles",
      "output": "one hit count per ray",
      "rows": [
        {
          "hit_count": 1,
          "ray_id": 1
        }
      ]
    },
    {
      "feature": "ray_tri_anyhit",
      "input": "rays plus triangles",
      "output": "one any-hit blocker row per ray",
      "rows": [
        {
          "any_hit": 1,
          "ray_id": 1
        },
        {
          "any_hit": 0,
          "ray_id": 2
        }
      ]
    },
    {
      "feature": "visibility_rows",
      "input": "observer points plus target points plus blocker triangles",
      "output": "line-of-sight rows with visible=1/0",
      "rows": [
        {
          "observer_id": 1,
          "target_id": 2,
          "visible": 0
        }
      ]
    },
    {
      "feature": "reduce_rows",
      "input": "emitted app rows",
      "output": "grouped summary rows",
      "rows": [
        {
          "pose_blocked": 1,
          "pose_id": 100
        },
        {
          "pose_blocked": 0,
          "pose_id": 200
        }
      ]
    },
    {
      "feature": "robot_collision_screening_app",
      "input": "robot link edge rays plus obstacle triangles",
      "output": "pose collision flags reduced from ray/triangle any-hit rows",
      "rows": {
        "colliding_pose_ids": [
          2,
          3
        ],
        "matches_oracle": true
      }
    },
    {
      "feature": "barnes_hut_force_app",
      "input": "bodies plus Python-built quadtree nodes",
      "output": "body-to-node candidate rows reduced to approximate force vectors",
      "rows": {
        "candidate_row_count": 24,
        "max_relative_error": 0.006558786879803883
      }
    },
    {
      "feature": "point_nearest_segment",
      "input": "points plus segments",
      "output": "nearest segment and distance rows",
      "rows": [
        {
          "distance": 1.0,
          "point_id": 1,
          "segment_id": 10
        }
      ]
    },
    {
      "feature": "segment_polygon_hitcount",
      "input": "segments plus polygons",
      "output": "one hit count per segment",
      "rows": [
        {
          "hit_count": 1,
          "segment_id": 1
        },
        {
          "hit_count": 1,
          "segment_id": 2
        }
      ]
    },
    {
      "feature": "segment_polygon_anyhit_rows",
      "input": "segments plus polygons",
