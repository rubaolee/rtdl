      "rows": [
        {
          "polygon_id": 10,
          "segment_id": 1
        },
        {
          "polygon_id": 11,
          "segment_id": 2
        }
      ]
    },
    {
      "feature": "polygon_pair_overlap_area_rows",
      "input": "left polygons plus right polygons",
      "output": "pairwise overlap area rows",
      "rows": [
        {
          "intersection_area": 4,
          "left_area": 9,
          "left_polygon_id": 1,
          "right_area": 9,
          "right_polygon_id": 10,
          "union_area": 14
        },
        {
          "intersection_area": 1,
          "left_area": 4,
          "left_polygon_id": 2,
          "right_area": 2,
          "right_polygon_id": 11,
          "union_area": 5
        }
      ]
    },
    {
      "feature": "polygon_set_jaccard",
      "input": "two polygon sets",
      "output": "one set-level Jaccard row",
      "rows": [
        {
          "intersection_area": 5,
          "jaccard_similarity": 0.2631578947368421,
          "left_area": 13,
          "right_area": 11,
          "union_area": 19
        }
      ]
    },
    {
      "feature": "fixed_radius_neighbors",
