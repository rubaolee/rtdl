            "row_id": 5
          },
          {
            "row_id": 7
          }
        ],
        "web_revenue_by_region": [
          {
            "region": "east",
            "sum": 180
          },
          {
            "region": "west",
            "sum": 240
          }
        ]
      },
      "summary": {
        "open_order_count_by_region": {
          "east": 2,
          "south": 1,
          "west": 2
        },
        "promo_order_count": 4,
        "web_revenue_by_region": {
          "east": 180,
          "west": 240
        }
      }
    },
