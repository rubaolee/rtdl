mkdir -p build
/usr/local/cuda-12/bin/nvcc -std=c++17 -O3 -shared -I/root/vendor/optix-sdk/include -I/usr/local/cuda-12/include  -DRTDL_OPTIX_INCLUDE_DIR=\"/root/vendor/optix-sdk/include\" -DRTDL_CUDA_INCLUDE_DIR=\"/usr/local/cuda-12/include\" -DRTDL_CUDA_SYSTEM_INCLUDE_DIR=\"/usr/include/x86_64-linux-gnu\" -Xcompiler -fPIC  \
	src/native/rtdl_optix.cpp \
	src/native/optix/rtdl_optix_cuda_helpers.cu \
	-L/usr/local/cuda-12/lib64 -lcuda -lnvrtc -lgeos_c  \
	-o build/librtdl_optix.so
