+            observed_total = int(json.loads(count_payload.decode("utf-8"))["count"])
+            if observed_total != total:
+                total = observed_total
+                page_offsets = list(range(0, total, int(args.page_size)))
+                if args.max_pages is not None:
+                    page_offsets = page_offsets[: int(args.max_pages)]
