+    def test_overlay_phase_trace_is_opt_in_jsonl(self) -> None:
+        import json
+        import os
+        import tempfile
+        from pathlib import Path
+
+        import rtdsl.rayjoin_overlay as overlay
+
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / "phase.jsonl"
+            old = os.environ.get("RTDL_RAYJOIN_OVERLAY_PHASE_TRACE_PATH")
+            try:
+                os.environ["RTDL_RAYJOIN_OVERLAY_PHASE_TRACE_PATH"] = str(path)
+                overlay._overlay_phase_trace("unit_event", value=7)
+            finally:
+                os.environ.pop("RTDL_RAYJOIN_OVERLAY_PHASE_TRACE_PATH", None)
+                if old is not None:
+                    os.environ["RTDL_RAYJOIN_OVERLAY_PHASE_TRACE_PATH"] = old
+
+            rows = [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines()]
+            self.assertEqual(rows[0]["event"], "unit_event")
+            self.assertEqual(rows[0]["value"], 7)
