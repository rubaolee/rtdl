+static __forceinline__ __device__ float rayjoin_cdb_sos_report_t(
+        float t,
+        double slope,
+        unsigned int query_map_id)
+{
+    const double pi = 3.14159265358979323846;
+    double norm_slope = (atan(slope) + 1.57079632679489661923) / pi;
+    if (norm_slope < 0.0) {
+        norm_slope = 0.0;
+    } else if (norm_slope > 1.0) {
+        norm_slope = 1.0;
+    }
+    // Encode the slope ordering used by RTDL's RayJoin CDB route into the
+    // reported hit distance so OptiX's strict tmax pruning cannot make
+    // equal-height boundary hits depend on BVH traversal order.
+    const double preference = query_map_id == 0u ? (1.0 - norm_slope) : norm_slope;
+    const float base_t = t <= 0.0f ? 1.0e-6f : t;
+    const float next_t = nextafterf(base_t, 3.402823466e38F);
+    float ulp = next_t - base_t;
+    if (!(ulp > 0.0f)) {
+        ulp = 1.0e-6f;
+    }
+    const float offset = ulp * (1.0f + static_cast<float>((1.0 - preference) * 64.0));
+    return base_t + offset;
+}
