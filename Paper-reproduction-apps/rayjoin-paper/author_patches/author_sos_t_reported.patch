 extern "C" __constant__ rayjoin::LaunchParamsPIP params;

+static __forceinline__ __device__ double rayjoin_pip_sos_tie_breaker(
+    double slope, unsigned int query_map_id) {
+  const double pi = 3.141592653589793238462643383279502884;
+  const double half_pi = 1.570796326794896619231321691639751442;
+  double norm_slope = (atan(slope) + half_pi) / pi;
+  if (norm_slope < 0.0) norm_slope = 0.0;
+  if (norm_slope > 1.0) norm_slope = 1.0;
+  return query_map_id == 0 ? norm_slope : (1.0 - norm_slope);
+}
+
+static __forceinline__ __device__ double rayjoin_pip_sos_report_t(
+    double t_edge, double slope, unsigned int query_map_id) {
+  const double factor = t_edge > 1.0 ? t_edge : 1.0;
+  const double tie_breaker = rayjoin_pip_sos_tie_breaker(slope, query_map_id);
+  return t_edge + factor * (1.0 - tie_breaker) * 1.0e-14;
+}
